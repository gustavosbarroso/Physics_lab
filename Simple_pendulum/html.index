<!DOCTYPE html>
<html>

<head>
<meta charset="UTF-8">

<title>Pêndulo Simples</title>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>

body{
    display:flex;
    gap:40px;
    font-family:Arial;
}

canvas{
    border:1px solid black;
}

.controls{
    width:250px;
}

.slider{
    width:200px;
}

</style>

</head>


<body>


<div>

<h2>Pêndulo</h2>

<canvas id="pendulo" width="400" height="400"></canvas>


<div id="info"></div>

</div>



<div>

<h2>Evolução temporal</h2>

<canvas id="grafico" width="500" height="300"></canvas>


<div class="controls">


<p>
g:
<input id="g" class="slider"
type="range"
min="1"
max="20"
step="0.1"
value="9.81">
</p>


<p>
L:
<input id="L" class="slider"
type="range"
min="0.1"
max="5"
step="0.01"
value="0.1">
</p>


<p>
θ₀:
<input id="theta0" class="slider"
type="range"
min="-3.14"
max="3.14"
step="0.01"
value="1">
</p>


<p>
ω₀:
<input id="omega0" class="slider"
type="range"
min="-10"
max="10"
step="0.1"
value="0">
</p>


</div>


</div>


<script src="pendulo.js"></script>


</body>

</html>
